# Copy this file to .env and fill in real values for local development.
# Never commit .env — it's already in .gitignore.

# Postgres connection string, used by apps/web (Prisma) once the data model lands
# (see TASKS.md -> "Data model + migrations"). Matches docker-compose.yml's db service.
DATABASE_URL="postgresql://optionwise:optionwise@localhost:5432/optionwise"

# Anthropic API key for services/ai's AnthropicProvider (SPEC.md's AI counsellor).
# Automated tests never read this — they use FakeProvider. Leave blank until that
# service exists.
ANTHROPIC_API_KEY=

# Optional LangSmith tracing for the AI service. Leave disabled unless you have a key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Disable Next.js's anonymous telemetry collection in dev/CI.
NEXT_TELEMETRY_DISABLED=1
